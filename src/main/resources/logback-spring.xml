<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration for CCE Collector Service.

  - default/local/staging:  Console output with human-readable pattern,
                            MDC fields included.
  - production:             JSON structured logging via LogstashEncoder,
                            MDC fields emitted as top-level JSON keys.
-->
<configuration>

    <!-- ═══════ Common MDC properties ═══════ -->
    <springProperty scope="context" name="APP_NAME"
                    source="spring.application.name"
                    defaultValue="cce-collector-service"/>

    <!-- ═══════ Console appender (non-production) ═══════ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5level [%thread] [%X{requestId}] [%X{correlationId}] [%X{cloudEventsId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ═══════ JSON appender (production) ═══════ -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${APP_NAME}"}</customFields>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>cloudEventsId</includeMdcKeyName>
            <includeMdcKeyName>source</includeMdcKeyName>
            <includeMdcKeyName>subject</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ═══════ Profile-specific root appender ═══════ -->

    <!-- Production: JSON structured logging -->
    <springProfile name="production">
        <logger name="org.openphc.cce.collector" level="INFO"/>
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.kafka" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.apache.kafka" level="WARN"/>
        <root level="WARN">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <!-- Staging: Console, INFO -->
    <springProfile name="staging">
        <logger name="org.openphc.cce.collector" level="INFO"/>
        <logger name="org.springframework.kafka" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Local / Test / Default: Console, DEBUG for service -->
    <springProfile name="local,test,default">
        <logger name="org.openphc.cce.collector" level="DEBUG"/>
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.kafka" level="WARN"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
